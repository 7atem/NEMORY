evaluation/reports/generated/

# Local validation/toolchain artifacts (source, Room and ObjectBox schemas stay tracked).
/.toolchain-tmp/
/*.log
/localization-gaps.json
/remediation-artifacts/

# Local credentials and generated release bundles are never source artifacts.
/.tmp/
.git-credentials
/app/release/
/iosApp/*.xcodeproj/
